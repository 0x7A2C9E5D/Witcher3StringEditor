<Window
    x:Class="Witcher3StringEditor.Dialogs.Views.LogDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:Witcher3StringEditor.Shared.Behaviors;assembly=Witcher3StringEditor.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:l="clr-namespace:Witcher3StringEditor.Locales;assembly=Witcher3StringEditor.Locales"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sf="http://schemas.syncfusion.com/wpf"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:Witcher3StringEditor.Dialogs.ViewModels"
    Title="{I18N {x:Static l:LangKeys.LogDialogTitle}}"
    Width="1200"
    Height="800"
    d:DataContext="{d:DesignInstance Type=vm:LogDialogViewModel}"
    ui:TitleBar.ExtendViewIntoTitleBar="True"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:WindowHelper.UseModernWindowStyle="True"
    WindowChrome.IsHitTestVisibleInChrome="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <!-- Set up the custom title bar regions through an attached behavior -->
    <i:Interaction.Behaviors>
        <b:CustomTitleBarBehavior />
    </i:Interaction.Behaviors>
    <!-- 
        Main grid layout for the log dialog
        Contains three rows: title bar, data grid, and pager controls
    -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Title bar row -->
            <RowDefinition Height="48" />
            <!-- Data grid row -->
            <RowDefinition Height="*" />
            <!-- Pager controls row -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Title bar area containing the dialog title and search box -->
        <Grid Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <!-- Padding column kept clear of the system caption buttons -->
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <!-- Dialog title text -->
            <TextBlock
                Grid.Column="0"
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Text="{I18N {x:Static l:LangKeys.LogDialogTitle}}" />
            <!-- Search box for filtering log entries -->
            <ui:AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="1"
                VerticalAlignment="Center"
                PlaceholderText="{I18N {x:Static l:LangKeys.SearchBoxPlaceholderText}}">
                <ui:AutoSuggestBox.QueryIcon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Search}" />
                </ui:AutoSuggestBox.QueryIcon>
            </ui:AutoSuggestBox>
            <!--
                Log management buttons, left to right (the group is right aligned):
                delete old logs (leftmost, kept away from the window caption buttons)
                -> open log folder -> report a bug (rightmost)
            -->
            <StackPanel
                Grid.Column="2"
                Margin="0,0,12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!-- Delete old logs button (kept leftmost, away from the window caption buttons) -->
                <Button
                    Width="48"
                    Height="48"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding DeleteOldLogsCommand}">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Broom}" />
                </Button>
                <!-- Open log folder button -->
                <Button
                    Width="48"
                    Height="48"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding OpenLogFolderCommand}">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Folder}" />
                </Button>
                <!-- Report a bug button -->
                <Button
                    Width="48"
                    Height="48"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding ReportBugCommand}">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Bug}" />
                </Button>
            </StackPanel>
        </Grid>
        <!-- Data grid displaying log events -->
        <sf:SfDataGrid
            x:Name="SfDataGrid"
            Grid.Row="1"
            Margin="16,16,16,0"
            AllowDeleting="True"
            AllowResizingColumns="True"
            AutoGenerateColumns="False"
            HeaderRowHeight="25"
            ItemsSource="{Binding PagedSource, ElementName=SfDataPager, Mode=TwoWay}"
            NavigationMode="Row"
            RowHeight="30"
            SelectionMode="Extended"
            ShowRowHeader="True"
            GridPasteOption="None">
            <!-- Data grid resources for customizing row header appearance -->
            <sf:SfDataGrid.Resources>
                <ResourceDictionary>
                    <!-- Style for row header cells to display row numbers -->
                    <Style TargetType="sf:GridRowHeaderCell">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="sf:GridRowHeaderCell">
                                    <Border
                                        x:Name="PART_RowHeaderCellBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding RowIndex, RelativeSource={RelativeSource TemplatedParent}}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </sf:SfDataGrid.Resources>
            <!-- Interaction behaviors for handling grid sizing, search and row height -->
            <i:Interaction.Behaviors>
                <!-- Behavior to handle grid size changes -->
                <b:SfDataGridSizeChangedBehavior />
                <!-- Behavior to handle row height queries -->
                <b:SfDataGridQueryRowHeightBehavior MinHeight="{Binding ElementName=SfDataGrid, Path=RowHeight}" />
                <!-- Behavior to drive the grid search from the search box -->
                <b:SfDataGridSearchBehavior SearchBox="{Binding ElementName=SearchBox}" />
                <!-- Behavior to dispose the grid when the window closes -->
                <b:SfDataGridDisposeOnCloseBehavior />
            </i:Interaction.Behaviors>
            <!-- Data grid columns definition -->
            <sf:SfDataGrid.Columns>
                <!-- Timestamp column -->
                <sf:GridDateTimeColumn
                    ColumnSizer="SizeToHeader"
                    HeaderText="{I18N {x:Static l:LangKeys.LogTime}}"
                    MappingName="Timestamp"
                    MinimumWidth="200"
                    Pattern="FullDateTime"
                    TextAlignment="Center" />
                <!-- Log level column -->
                <sf:GridTextColumn
                    ColumnSizer="SizeToHeader"
                    HeaderText="{I18N {x:Static l:LangKeys.LogLevel}}"
                    MappingName="Level"
                    MinimumWidth="150"
                    TextAlignment="Center" />
                <!-- Log message column -->
                <sf:GridTextColumn
                    ColumnSizer="AutoWithLastColumnFill"
                    HeaderText="{I18N {x:Static l:LangKeys.LogMessage}}"
                    MappingName="Message"
                    MinimumWidth="700"
                    TextWrapping="WrapWithOverflow" />
            </sf:SfDataGrid.Columns>
        </sf:SfDataGrid>
        <!-- Data pager for pagination of log events -->
        <sf:SfDataPager
            x:Name="SfDataPager"
            Grid.Row="2"
            Margin="0,4"
            HorizontalAlignment="Center"
            NumericButtonCount="10"
            PageSize="30"
            Source="{Binding LogEvents}">
            <!-- Interaction behaviors for handling pager operations -->
            <i:Interaction.Behaviors>
                <!-- Behavior to dispose the pager when the window closes -->
                <b:SfDataPagerDisposeOnCloseBehavior />
            </i:Interaction.Behaviors>
        </sf:SfDataPager>
    </Grid>
</Window>