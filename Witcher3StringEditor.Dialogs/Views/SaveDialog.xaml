<Window
    x:Class="Witcher3StringEditor.Dialogs.Views.SaveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iwk="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:l="clr-namespace:Witcher3StringEditor.Locales;assembly=Witcher3StringEditor.Locales"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:Witcher3StringEditor.Dialogs.ViewModels"
    xmlns:com="clr-namespace:Witcher3StringEditor.Contracts;assembly=Witcher3StringEditor.Contracts"
    xmlns:codec="clr-namespace:Witcher3StringEditor.Contracts;assembly=Witcher3StringEditor.Contracts"
    xmlns:con="clr-namespace:Witcher3StringEditor.Dialogs.Converters"
    Title="{I18N {x:Static l:LangKeys.SaveDialogTitle}}"
    Width="800"
    Height="500"
    d:DataContext="{d:DesignInstance Type=vm:SaveDialogViewModel}"
    ui:TitleBar.ExtendViewIntoTitleBar="True"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:WindowHelper.UseModernWindowStyle="True"
    WindowChrome.IsHitTestVisibleInChrome="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <!-- 
        Window resources containing data providers and converters
    -->
    <Window.Resources>
        <ResourceDictionary>
            <!-- Style for expander controls -->
            <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
            <Style BasedOn="{StaticResource ExpanderCardStyle}" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <!-- Data provider for The Witcher 3 file formats enumeration -->
            <ObjectDataProvider
                x:Key="FileFormat"
                MethodName="GetValues"
                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="com:FileFormat" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <!-- Data provider for The Witcher 3 languages enumeration -->
            <ObjectDataProvider
                x:Key="W3Language"
                ObjectInstance="{x:Static codec:Language.All}" />
            <!-- Converter for displaying The Witcher 3 language native names -->
            <con:W3LanguageToNativeNameConverter x:Key="W3LanguageToNativeNameConverter" />
            <!-- Converter for displaying The Witcher 3 file type localized strings -->
            <con:W3FileFormatToLocalizedStringConverter x:Key="W3FileFormatToLocalizedStringConverter" />
            <!-- Converter for displaying the W3Strings payload encodings -->
            <con:W3StringsEncodingToDisplayStringConverter x:Key="W3StringsEncodingToDisplayStringConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <!-- 
        Main grid layout for the save dialog
        Contains two rows: title bar and content area
    -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Title bar row -->
            <RowDefinition Height="48" />
            <!-- Content area row -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Title text displayed in the title bar area -->
        <TextBlock
            Margin="20,0,0,0"
            VerticalAlignment="Center"
            Text="{I18N {x:Static l:LangKeys.SaveDialogTitle}}" />
        <!-- Content grid containing save settings and action buttons -->
        <Grid Grid.Row="1" Margin="24,24,16,24">
            <Grid.RowDefinitions>
                <!-- Save settings area -->
                <RowDefinition Height="Auto" />
                <!-- Action buttons area -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Expander control for save settings -->
            <Expander VerticalAlignment="Top" IsExpanded="True">
                <!-- Expander header containing file type selection -->
                <Expander.Header>
                    <Grid Height="Auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- File type label -->
                        <TextBlock VerticalAlignment="Center" Text="{I18N {x:Static l:LangKeys.TargetFiletype}}" />
                        <!-- File type selection combobox -->
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Source={StaticResource FileFormat}}"
                            SelectedValue="{Binding TargetFileFormat}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding
                                                Converter="{StaticResource W3FileFormatToLocalizedStringConverter}">
                                                <Binding />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Expander.Header>
                <!-- Expander content containing language and container version settings -->
                <Expander.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Language selection row -->
                            <RowDefinition Height="Auto" />
                            <!-- Payload encoding selection row -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Target language label -->
                        <TextBlock VerticalAlignment="Center" Text="{I18N {x:Static l:LangKeys.TargetLanguage}}" />
                        <!-- Target language selection combobox -->
                        <ComboBox
                            Grid.Row="0"
                            HorizontalAlignment="Right"
                            ItemsSource="{Binding Source={StaticResource W3Language}}"
                            SelectedValue="{Binding TargetLanguage}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding Converter={StaticResource W3LanguageToNativeNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!-- Payload encoding selection (only visible for W3Strings file type) -->
                        <Grid Grid.Row="1">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <!-- Show when file format is W3Strings -->
                                        <DataTrigger Binding="{Binding TargetFileFormat}"
                                                     Value="{x:Static com:FileFormat.W3Strings}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <!-- Game version label -->
                            <TextBlock
                                Margin="0,16,0,0"
                                VerticalAlignment="Center"
                                Text="{I18N {x:Static l:LangKeys.GameVersion}}" />
                            <!-- Payload encoding selection combobox -->
                            <ComboBox
                                Margin="0,16,0,0"
                                HorizontalAlignment="Right"
                                ItemsSource="{Binding Encodings}"
                                SelectedValue="{Binding TargetEncoding}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding Converter={StaticResource W3StringsEncodingToDisplayStringConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Grid>
                </Expander.Content>
            </Expander>
            <!-- Action buttons for saving or canceling -->
            <iwk:SimpleStackPanel
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,24"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <!-- Save button -->
                <Button
                    MinWidth="100"
                    Command="{Binding SaveCommand}">
                    <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Save}"
                                    Content="{I18N {x:Static l:LangKeys.SaveBtnContent}}" Spacing="8" />
                </Button>
                <!-- Cancel button -->
                <Button
                    MinWidth="100"
                    Command="{Binding CancelCommand}">
                    <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Cancel}"
                                    Content="{I18N {x:Static l:LangKeys.CancelBtnContent}}" Spacing="8" />
                </Button>
            </iwk:SimpleStackPanel>
        </Grid>
    </Grid>
</Window>